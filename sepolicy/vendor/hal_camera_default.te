# Nothing camera algorithm service (vendor.noth.hardware.camera-service) runs in
# hal_camera_default, the QTI camera provider domain.
hal_server_domain(hal_camera_default, vendor_hal_noth_camera)

hal_client_domain(priv_app, vendor_hal_noth_camera)
hal_client_domain(priv_app_36, vendor_hal_noth_camera)
hal_client_domain(platform_app, vendor_hal_noth_camera)
hal_client_domain(platform_app_36, vendor_hal_noth_camera)

binder_call(hal_camera_default, hal_camera_default)
allow hal_camera_default proc_meminfo:file r_file_perms;
allow hal_camera_default fwk_camera_service:service_manager find;

# memfd shared buffers between the algorithm service and com.nothing.camera
# (INtCamSession image/parameter transport).
allow { priv_app priv_app_36 platform_app platform_app_36 } vendor_hal_noth_camera:memfd_file { read write getattr map };
allow vendor_hal_noth_camera { priv_app priv_app_36 platform_app platform_app_36 }:memfd_file { read write getattr map };
